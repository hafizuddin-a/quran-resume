{
  "manifest_version": 3,
  "name": "Quran Resume",
  "version": "1.6.2",
  "homepage_url": "https://github.com/hafizuddin-a/quran-resume",
  "description": "Opens quran.com as a pinned, active tab on browser startup, at the verse where you last stopped reading.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "idle",
    "alarms"
  ],
  "host_permissions": [
    "https://quran.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon32.png"
      ],
      "matches": [
        "https://quran.com/*"
      ]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://quran.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Quran Resume",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  },
  "commands": {
    "open-quran": {
      "suggested_key": {
        "default": "Alt+Shift+Q"
      },
      "description": "Open the Quran at your last verse"
    }
  }
}
